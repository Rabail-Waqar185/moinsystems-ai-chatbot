# Application
APP_ENV=local
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173
APP_SECRET=change-me-to-a-random-64-char-string

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/moin_ai_chatbot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# LLM provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# RAG tuning
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.72

# Email (smtp | transactional)
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=your gmail address,
# SMTP_PASSWORD=a 16-char App Password (not your normal password) —
# generate one at https://myaccount.google.com/apppasswords (requires 2FA on).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Set to YOUR personal address during testing; swap to the real inbox at go-live.
LEAD_EMAIL_TO=

# Rate limiting
RATE_LIMIT=30/minute
